// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
}

// 用户角色枚举
enum UserRole {
  admin    // 管理员
  merchant // 商户
}

// ===================== 用户表（已有） =====================
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique // 用户名，唯一
  password  String   // 密码（加密存储）
  email     String?  // 邮箱（可选）
  phone     String   @unique // 手机号，唯一
  role      UserRole @default(merchant) // 用户角色，默认商户
  status    Int      @default(1) // 状态：1-正常，0-禁用
  createdAt DateTime @default(now()) // 创建时间
  updatedAt DateTime @updatedAt // 更新时间

  // 关联酒店项目
  hotelProjects HotelProject[]

  @@map("users") // 表名映射
}

// ===================== 第一层：酒店项目表 =====================
model HotelProject {
  id          Int       @id @default(autoincrement())
  hotelId     String    @unique @map("hotel_id")     // 酒店唯一业务ID
  name        String?                                // 酒店名称（可选）
  hotelType   String?   @map("hotel_type")           // 酒店类型
  status      String    @default("draft")            // 状态：draft/pending/approved/rejected/offline/pending_update
  creatorId   Int       @map("creator_id")           // 创建人ID
  creator     String                                 // 创建人姓名
  remark      String?                                // 备注
  submitTime  DateTime? @map("submit_time")          // 提交审核时间
  hasUnpublishedChanges Boolean @default(false) @map("has_unpublished_changes") // 是否有未发布的修改
  isDeleted   Boolean   @default(false) @map("is_deleted")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // 关联
  user        User          @relation(fields: [creatorId], references: [id])
  details     HotelDetail[] // 1:N 关联详情（支持多版本）
  rooms       HotelRoom[]   // 1:N 关联房型

  @@map("hotel_projects")
}

// ===================== 第二层：酒店详情表 =====================
model HotelDetail {
  id              Int      @id @default(autoincrement())
  hotelId         String   @map("hotel_id")           // 酒店业务ID
  version         String   @default("draft")          // 版本：draft（草稿）/ published（已发布）

  // 基本信息
  fullName        String?  @map("full_name")          // 酒店全称
  englishName     String?  @map("english_name")       // 英文名
  starRating      Int?     @map("star_rating")        // 星级
  brand           String?                             // 品牌
  openingYear     Int?     @map("opening_year")       // 开业年份
  renovationYear  Int?     @map("renovation_year")    // 装修年份
  totalRooms      Int?     @map("total_rooms")        // 客房总数
  totalFloors     Int?     @map("total_floors")       // 楼层数

  // 位置信息
  country         String?  @default("中国")
  province        String?
  city            String?
  district        String?
  address         String?                             // 详细地址
  longitude       Float?                              // 经度
  latitude        Float?                              // 纬度

  // 联系方式
  phone           String?                             // 联系电话（与前端统一）
  contactEmail    String?  @map("contact_email")
  frontDeskPhone  String?  @map("front_desk_phone")
  fax             String?

  // 入住政策
  checkInTime     String?  @default("14:00") @map("check_in_time")
  checkOutTime    String?  @default("12:00") @map("check_out_time")
  childrenPolicy  String?  @map("children_policy")
  petPolicy       String?  @map("pet_policy")
  cancellationPolicy String? @map("cancellation_policy")  // 与前端统一
  otherPolicies   String?  @map("other_policies")         // 前端独有字段

  // 其他信息
  description     String?                             // 酒店描述
  highlight       String?                             // 酒店亮点
  trafficInfo     String?  @map("traffic_info")       // 交通信息
  coverImage      String?  @map("cover_image")        // 封面图

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // 关联
  project         HotelProject    @relation(fields: [hotelId], references: [hotelId])
  facilities      HotelFacility[] // 1:N 酒店设施
  images          HotelImage[]    // 1:N 酒店图片
  policies        HotelPolicy[]   // 1:N 酒店政策

  @@unique([hotelId, version])
  @@map("hotel_details")
}

// ===================== 酒店政策表 =====================
model HotelPolicy {
  id              Int      @id @default(autoincrement())
  policyId        String   @unique @map("policy_id")    // 政策唯一业务ID
  hotelId         String   @map("hotel_id")             // 所属酒店
  version         String   @default("draft")            // 版本：draft / published

  policyType      String   @map("policy_type")          // 政策类型: checkIn/checkOut/pet/cancel/parking/other
  policyName      String   @map("policy_name")          // 政策名称
  policyContent   String?  @map("policy_content")       // 政策内容

  sortOrder       Int      @default(0) @map("sort_order")
  isDeleted       Boolean  @default(false) @map("is_deleted")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // 关联（关联到详情的 hotelId，version 需保持一致）
  detail          HotelDetail @relation(fields: [hotelId, version], references: [hotelId, version])

  @@map("hotel_policies")
}

// ===================== 第三层：房型信息表 =====================
model HotelRoom {
  id              Int      @id @default(autoincrement())
  roomId          String   @unique @map("room_id")    // 房型唯一业务ID
  hotelId         String   @map("hotel_id")           // 所属酒店
  version         String   @default("draft")          // 版本：draft / published

  // 房型基本信息（与前端 RoomDetail 字段统一）
  roomName        String   @map("room_name")          // 房间名称
  roomType        String?  @map("room_type")          // 房型类型
  bedType         String?  @map("bed_type")           // 床型
  bedCount        String?  @map("bed_count")          // 床铺数量（String，与前端统一）
  bedSize         String?  @map("bed_size")           // 床尺寸
  roomSize        String?  @map("room_size")          // 房间大小（如"30㎡"，与前端统一）
  floor           String?                             // 所在楼层（与前端统一）
  windowType      String?  @map("window_type")        // 窗户类型
  maxOccupancy    String?  @map("max_occupancy")      // 入住人数（String，与前端统一）

  // 价格与库存
  basePrice       Int?     @map("base_price")         // 基础价格（单位：分）
  breakfastType   String?  @default("none") @map("breakfast_type")
  breakfastCount  Int?     @default(0) @map("breakfast_count")
  totalCount      Int?     @default(0) @map("total_count")
  availableCount  Int?     @default(0) @map("available_count")

  // 其他
  description     String?
  coverImage      String?  @map("cover_image")
  status          String   @default("active")         // active/inactive
  sortOrder       Int      @default(0) @map("sort_order")
  isDeleted       Boolean  @default(false) @map("is_deleted")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // 关联
  project         HotelProject   @relation(fields: [hotelId], references: [hotelId])
  facilities      RoomFacility[] // 房型设施
  images          RoomImage[]    // 房型图片

  @@map("hotel_rooms")
}

// ===================== 辅助表 =====================

// 酒店公共设施
model HotelFacility {
  id               Int      @id @default(autoincrement())
  hotelId          String   @map("hotel_id")
  version          String   @default("draft")          // 版本：draft / published
  facilityCode     String   @map("facility_code")
  facilityName     String   @map("facility_name")
  facilityCategory String?  @default("general") @map("facility_category")
  description      String?  @map("description")        // 设施描述（可选）
  isFree           Boolean  @default(true) @map("is_free")
  createdAt        DateTime @default(now()) @map("created_at")

  detail           HotelDetail @relation(fields: [hotelId, version], references: [hotelId, version])

  @@unique([hotelId, version, facilityCode])
  @@map("hotel_facilities")
}

// 酒店图片
model HotelImage {
  id        Int      @id @default(autoincrement())
  hotelId   String   @map("hotel_id")
  version   String   @default("draft")               // 版本：draft / published
  imageUrl  String   @map("image_url")
  imageType String   @default("hotel") @map("image_type")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  detail    HotelDetail @relation(fields: [hotelId, version], references: [hotelId, version])

  @@map("hotel_images")
}

// 房型设施
model RoomFacility {
  id           Int      @id @default(autoincrement())
  roomId       String   @map("room_id")
  facilityCode String   @map("facility_code")
  facilityName String   @map("facility_name")
  createdAt    DateTime @default(now()) @map("created_at")

  room         HotelRoom @relation(fields: [roomId], references: [roomId])

  @@unique([roomId, facilityCode])
  @@map("room_facilities")
}

// 房型图片
model RoomImage {
  id        Int      @id @default(autoincrement())
  roomId    String   @map("room_id")
  imageUrl  String   @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  room      HotelRoom @relation(fields: [roomId], references: [roomId])

  @@map("room_images")
}
